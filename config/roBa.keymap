#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/* tamanho do passo de scroll do encoder (com smooth scrolling ligado);
 * valor da comunidade roBa — ajustar se scrollar demais/de menos */
/* &msc é taxa POR SEGUNDO: total por detent = SCRL_VAL x tap-ms/1000.
 * 2400 x 60ms = ~144 unidades hi-res (~1,2 tick de rodinha), espalhadas
 * em micro-reports = scroll smooth estilo trackpad, sem lag. */
/* Velocidade por detent = SCRL_VAL x tap-ms/1000 (dial de velocidade: SCRL_VAL).
 * 3600 x 10ms = ~36 unidades hi-res por detent (~1 linha) — mesma velocidade
 * do antigo 1800x20ms, mas tap de 10ms corta pela metade a janela em que
 * detents consecutivos colidem e se perdem em giro rápido. */
#define ZMK_POINTING_DEFAULT_SCRL_VAL 3600

#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
};

&lt {
    flavor = "balanced";
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
};

/* Sticky keys (Cmd, Shift): solta o mod no PRESS da tecla seguinte, não no
 * release — digitando rápido, "Ex" não vira mais "EX". */

&sk { quick-release; };

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    /* Combo é global por default e o ZMK filtra pela layer ativa MAIS ALTA.
     * Várias posições de combo caem em cima de teclas reais da Num: print
     * (31 32) fica em N2+N3 — digitar "23" rápido tirava screenshot;
     * double_quotation (20 21) fica em N6+MINUS; as de janela (5-9, 28-31)
     * pegam N7/N8/N9 e N1/N2.
     *
     * layers = <0>   -> combos que colidem com a Num. Só na base. Não basta
     *                   listar <0 4>: com Space (Num) segurado + esbarrão no
     *                   trackball, a mais alta vira 4 e o combo voltaria.
     * layers = <0 4> -> combos cujas posições são &trans na Num (sem colisão);
     *                   seguem valendo durante a janela do automouse. */

    combos {
        compatible = "zmk,combos";

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        til {
            bindings = <&kp TILDE>;
            key-positions = <0 1>;
            require-prior-idle-ms = <150>;
            layers = <0 4>;
        };

        play {
            bindings = <&play>;
            key-positions = <35 34>;
            require-prior-idle-ms = <150>;
            layers = <0 4>;
        };

        next {
            bindings = <&next>;
            key-positions = <35 36>;
            require-prior-idle-ms = <150>;
            layers = <0 4>;
        };

        print {
            bindings = <&print>;
            key-positions = <31 32>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        telaesquerda {
            bindings = <&telaesquerda>;
            key-positions = <5 6 7>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        telameio {
            bindings = <&telameio>;
            key-positions = <6 7 8>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        teladireita {
            bindings = <&teladireita>;
            key-positions = <9 8 7>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        reposicionar {
            bindings = <&redefinirtela>;
            key-positions = <28 29 30>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        telatoda {
            bindings = <&telatoda>;
            key-positions = <29 30 31>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        missioncontrol {
            bindings = <&kp LC(UP_ARROW)>;
            key-positions = <1 2 3>;
            require-prior-idle-ms = <150>;
            layers = <0 4>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        print: print {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LS(LG(NUMBER_4))>;

            label = "PRINT";
        };

        play: play {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LG(LA(UP_ARROW))>;

            label = "PLAY";
        };

        next: next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LG(LA(RIGHT))>;

            label = "NEXT";
        };

        telaesquerda: telaesquerda {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LC(LA(LEFT_ARROW))>;

            label = "TELAESQUERDA";
        };

        telameio: telameio {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LC(LA(C))>;

            label = "TELAMEIO";
        };

        teladireita: teladireita {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LC(LA(RIGHT_ARROW))>;

            label = "TELADIREITA";
        };

        redefinirtela: redefinirtela {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LG(LC(LA(SPACE)))>;

            label = "REDEFINIRTELA";
        };

        telatoda: telatoda {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LC(LA(F))>;

            label = "TELATODA";
        };
    };

    behaviors {
        mo_scroll: mo_scroll {
            compatible = "zmk,behavior-hold-tap";
            label = "MO_SCROLL";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <160>;
            bindings = <&mo>, <&mkp>;
        };

        /* Tap-dance:
 * 1 tap  -> MB3
 * 2 taps -> Sticky layer 5 (SCROLL)
 */

        td_scroll: td_scroll {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SCROLL";
            #binding-cells = <0>;
            tapping-term-ms = <150>;

            /* 1 tap  -> mo_scroll (tap = MB3, hold = MO 5)
     * 2 taps -> sticky layer 5
     */

            bindings = <&mo_scroll 5 MB3 &sl 5>;
        };

        tap_key_hold_layer: tap_key_hold_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_KEY_HOLD_LAYER";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <120>;
            require-prior-idle-ms = <150>;

            /* tap = key
     * hold = momentary layer
     */

            bindings = <&mo>, <&kp>;
        };

        mo_kp: mo_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "MO_KP";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        mo_mouse_click: mo_mouse_click {
            compatible = "zmk,behavior-hold-tap";
            label = "MO_MOUSE_CLICK";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&mo>, <&mkp>;
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // Encoder -> scroll de mouse (usa &msc)

        rot_scroll: rot_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ROT_SCROLL";
            #sensor-binding-cells = <2>;

            // CW e CCW vão chamar &msc com parâmetros diferentes (SCRL_DOWN / SCRL_UP)
            // 10ms: mínimo que ainda garante o report sair; 20 perdia detents <20ms

            tap-ms = <10>;
            bindings = <&msc>, <&msc>;
        };

        // Tap dance na tecla A:
        // 1 toque  -> A
        // 2 toques -> @

        td_a: td_a {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_A";
            #binding-cells = <0>;
            tapping-term-ms = <400>;      // pode ajustar depois se quiser mais rápido/lento
            bindings = <&kp A>, <&kp AT>;
        };

        // Tap dance na tecla Q:
        // 1 toque  -> Q
        // 2 toques -> !

        td_q: td_q {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_Q";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&kp Q>, <&kp EXCLAMATION>;
        };

        /* Tecla -/~ : hold-preferred + sem prior-idle porque o hold (til pro ã)
         * é usado no meio de palavra rápida ("não") — as regras globais do &mt
         * (balanced + prior-idle 150) faziam sair "-a" ou "-" solto. */

        til_mt: til_mt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
        };

        /* Layer-tap dedicado do Space (camada Num). Sem quick-tap: re-segurar
         * o Space logo apos um espaco virava REPEAT de espaco em vez de layer.
         * Sem prior-idle: segurar Space ate 150ms depois da ultima tecla
         * resolvia como tap e o primeiro numero saia letra. */

        lt_num: lt_num {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_NUM";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        til_dash: til_dash {
            compatible = "zmk,behavior-hold-tap";
            label = "TIL_DASH";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <150>;

            /* hold  = &mo <layer>
             * tap   = &kp <keycode>
             */

            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q                    &kp W    &kp E           &kp R     &kp T                                                                     &kp Y           &kp U  &kp I                    &kp O    &kp P
&kp A                    &kp S    &kp D           &kp F     &kp G                               &kp K_MUTE           &kp RETURN       &kp H           &kp J  &tap_key_hold_layer 5 K  &kp L    &kp SQT
&kp Z                    &kp X    &kp C           &kp V     &kp B                               &til_mt TILDE MINUS      &lt 6 SEMI       &kp N           &kp M  &kp COMMA                &kp DOT  &kp SLASH
&mt LEFT_CONTROL ESCAPE  &kp TAB  &td_scroll      &mkp MB2  &sk LEFT_COMMAND                    &lt_num 1 SPACE          &lt 2 BACKSPACE  &sk LEFT_SHIFT                                           &kp LG(LEFT_BRACKET)
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

        Num {
            bindings = <
&trans  &trans  &trans  &trans  &trans                             &trans           &kp N7  &kp N8  &kp N9  &kp KP_MULTIPLY
&trans  &trans  &trans  &trans  &trans  &trans      &kp ENTER      &trans           &kp N4  &kp N5  &kp N6  &kp KP_SUBTRACT
&trans  &trans  &trans  &trans  &trans  &trans      &kp COMMA      &kp DOT          &kp N1  &kp N2  &kp N3  &kp PLUS
&trans  &trans  &trans  &trans  &trans  &trans      &kp BACKSPACE  &kp KP_NUMBER_0                          &kp EQUAL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        Signs {
            bindings = <
&kp EXCLAMATION  &kp AT  &kp HASH  &kp DOLLAR  &kp PERCENT                                                   &kp CARET  &kp AMPERSAND  &kp ASTERISK  &trans  &trans
&kp AT           &trans  &trans    &trans      &trans       &kp LEFT_BRACKET          &kp RIGHT_BRACKET      &trans     &trans         &trans        &trans  &trans
&trans           &trans  &trans    &trans      &trans       &kp LEFT_PARENTHESIS      &kp RIGHT_PARENTHESIS  &trans     &trans         &trans        &trans  &trans
&trans           &trans  &trans    &trans      &trans       &trans                    &trans                 &trans                                          &trans
            >;

            sensor-bindings = <&inc_dec_kp DELETE BACKSPACE>;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        /* Automouse (layer 4). Só J = clique e L = clique direito; TODO o resto
         * é &trans de propósito.
         *
         * Antes esta camada REPETIA o alfabeto inteiro. Como layer ativa mais
         * alta ganha, um esbarrão no trackball armava a MOUSE e ela sobrescrevia
         * a Num (layer 1) que estava embaixo: segurando Space pra digitar
         * número, saía a LETRA (7/8/9 viram U/I/O). Com &trans, a MOUSE não
         * tapa mais nada — cai pra camada de baixo, seja base ou Num. */

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &trans  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                              &trans
            >;

            sensor-bindings = <&rot_scroll SCRL_UP SCRL_DOWN>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&rot_scroll SCRL_UP SCRL_DOWN>;
        };

        BT {
            bindings = <
&bootloader  &trans  &trans  &trans  &trans                      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans       &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans        &trans        &trans        &trans
&trans       &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans       &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
